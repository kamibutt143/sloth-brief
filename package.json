  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.74",
    "@mastra/core": "^1.78.0",
    "dotenv": "^18.0.8",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
