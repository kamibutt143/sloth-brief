# Copy to .env and adjust. All values are optional — defaults shown.

# Any open-weight model Ollama can pull.
SLOTH_MODEL=gemma3:4b

# Ollama's OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1

# How far back the overnight window reaches (hours).
SLOTH_WINDOW_HOURS=12

# Cap on items handed to the model.
SLOTH_MAX_ITEMS=40
